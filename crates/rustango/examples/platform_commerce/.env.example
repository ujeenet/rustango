# Copy to .env and edit for your environment; src/main.rs loads it at startup.
# Defaults suit `docker compose up -d`; the database name matches
# docker-compose.yml. Running cargo on the host instead of in the rust
# container? Change `postgres` -> `localhost` below.
DATABASE_URL=postgres://rustango:rustango@postgres:5432/platform_commerce_dev
# Bind address. Unset, the tier's `[server] bind` applies (127.0.0.1 in
# dev); docker-compose.yml sets 0.0.0.0 for the container only.
# RUSTANGO_BIND=127.0.0.1:8080

# Session signing key — base64 of at least 32 bytes. Outside prod a bad
# value only warns at boot and the key saved in ./var/ is used instead;
# on prod the server refuses to start. Leave it commented in development;
# set a real one in production and keep it out of source control:
#   RUSTANGO_SESSION_SECRET=$(openssl rand -base64 32)
# RUSTANGO_SESSION_SECRET=

# Encryption key for sealed secrets: saved database server passwords,
# tenant database URLs, EncryptedString fields. Any string of 32 or more
# characters (it is hashed into the key); back it up: without it sealed
# values cannot be read. Unset on the dev and test tiers, a key is
# generated and saved in ./var/; staging and prod must set it.
#   RUSTANGO_SECRET_KEY=$(openssl rand -base64 48)
# RUSTANGO_SECRET_KEY=
# Rotation: old key here, new one above.
# RUSTANGO_SECRET_KEY_PREVIOUS=

# Log filter, standard RUST_LOG syntax. Default is `info,sqlx=warn`.
# Production sets this in the orchestrator rather than here.
# RUST_LOG=info,my_app=debug
