#!/usr/bin/env bash
# rustango — pre-push hook.
#
# Heavier checks that would slow `git commit` to a crawl, but you
# want to know about before code leaves your machine.
#
# Skip everything with `git push --no-verify`. Per-step overrides:
#   PREPUSH_SKIP_CHECK=1     skip cargo check
#   PREPUSH_SKIP_CLIPPY=1    skip cargo clippy
#   PREPUSH_SKIP_TESTS=1     skip cargo test --lib
#   PREPUSH_DENY=1           opt-in cargo deny check (heaviest)
#   PREPUSH_TRIVY=1          opt-in trivy vulnerability scan if installed
#
# Install once per clone: `bin/install-hooks.sh`.

set -euo pipefail

export PATH="$HOME/.cargo/bin:$PATH"

red()    { printf '\033[31m%s\033[0m\n' "$*"; }
green()  { printf '\033[32m%s\033[0m\n' "$*"; }
yellow() { printf '\033[33m%s\033[0m\n' "$*"; }
gray()   { printf '\033[2m%s\033[0m\n'  "$*"; }

start=$(date +%s)

# ---------------------------------------------------------------- cargo check
if [ "${PREPUSH_SKIP_CHECK:-0}" != "1" ]; then
  gray "[pre-push] cargo check --workspace --all-features"
  if ! cargo check --workspace --all-features 2>&1 | tail -20; then
    red "[pre-push] cargo check failed"
    exit 1
  fi
fi

# ---------------------------------------------------------------- clippy
# Clippy on the rustango lib only — the workspace currently carries
# pre-existing pedantic warnings, so we'd produce noise without
# `--no-deps` + scoping. Block on warnings introduced AFTER baseline
# (rustango lib) only.
if [ "${PREPUSH_SKIP_CLIPPY:-0}" != "1" ]; then
  gray "[pre-push] cargo clippy -p rustango --features tenancy --lib --no-deps"
  if ! cargo clippy -p rustango --features tenancy --lib --no-deps 2>&1 | tail -10; then
    red "[pre-push] cargo clippy failed"
    yellow "[pre-push] override with: PREPUSH_SKIP_CLIPPY=1 git push"
    exit 1
  fi
fi

# ---------------------------------------------------------------- lib tests
if [ "${PREPUSH_SKIP_TESTS:-0}" != "1" ]; then
  gray "[pre-push] cargo test -p rustango --features tenancy --lib"
  if ! cargo test -p rustango --features tenancy --lib 2>&1 | tail -3; then
    red "[pre-push] cargo test --lib failed"
    yellow "[pre-push] live integration tests are NOT run here (need DATABASE_URL)"
    yellow "[pre-push] override with: PREPUSH_SKIP_TESTS=1 git push"
    exit 1
  fi

  # ------------------------------------------------------ repo-consistency guards
  #
  # The line above is `--lib` only, so integration tests never run here.
  # These three are the exception worth making: they read files and need
  # no database, they finish in about a second, and each guards a kind of
  # drift that is invisible on inspection.
  #
  #   docs_versions      — sample output and the docs manifest must name
  #                        the version actually shipping. A release bump
  #                        touches 14 places across four locales; this is
  #                        what notices when one is missed.
  #   docs_links         — in-page links, including the translated trees.
  #   pool_construction  — no production site opens a pool behind the
  #                        framework's back.
  #
  # Added after a 0.58.0 bump left the docs at 0.57 and failed CI on
  # every open PR — including one that touched only the changelog.
  gray "[pre-push] repo-consistency guards (docs_versions, docs_links, pool_construction)"
  if ! cargo test -p rustango --no-default-features --features sqlite,tenancy \
        --test docs_versions --test docs_links --test pool_construction 2>&1 | tail -12; then
    red "[pre-push] a repo-consistency guard failed"
    yellow "[pre-push] override with: PREPUSH_SKIP_TESTS=1 git push"
    exit 1
  fi
fi

# ---------------------------------------------------------------- cargo deny (opt-in)
if [ "${PREPUSH_DENY:-0}" = "1" ] && command -v cargo-deny >/dev/null 2>&1; then
  gray "[pre-push] cargo deny check"
  if ! cargo deny check 2>&1 | tail -10; then
    red "[pre-push] cargo deny check failed"
    exit 1
  fi
fi

# ---------------------------------------------------------------- trivy vuln (opt-in)
# Cargo.lock vulnerability (CVE) scan — the same gate CI enforces on
# every PR. Blocks on HIGH/CRITICAL with a fix available.
if [ "${PREPUSH_TRIVY:-0}" = "1" ] && command -v trivy >/dev/null 2>&1; then
  gray "[pre-push] trivy fs --scanners vuln (Cargo.lock CVEs)"
  if ! trivy fs --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed \
        --skip-dirs target --exit-code 1 --no-progress --quiet . 2>&1 | tail -20; then
    red "[pre-push] trivy found HIGH/CRITICAL vulnerabilities"
    yellow "[pre-push] triage/upgrade the dependency, or override with: PREPUSH_TRIVY=0 git push"
    exit 1
  fi
fi

elapsed=$(( $(date +%s) - start ))
green "[pre-push] ok (${elapsed}s)"
