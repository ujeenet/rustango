/target
/Cargo.lock
**/*.rs.bk

# Nested example projects (cookbook_blog, blog_demo, etc.) are
# standalone Cargo packages with their own target/ + Cargo.lock —
# don't commit either.
crates/rustango/examples/*/target/
crates/rustango/examples/*/Cargo.lock
# shared target dir bin/examples.sh builds every example into (override: EX_TARGET)
/target-examples/
.DS_Store
.idea/
.vscode/

# AI / coding-agent tooling — per-developer local config, never shared.
# These files accumulate absolute paths, per-machine command allowlists,
# and session state; they are not part of the project.
.claude/
CLAUDE.md
AGENTS.md
.mcp.json
.cursor/
.cursorrules
.cursorignore
.cursorindexingignore
.aider*
.continue/
.windsurf/
.windsurfrules
.codeium/
.roo/
.roomodes
.cline/
.clinerules
.gemini/
GEMINI.md
.junie/
.qodo/
.specstory/
.github/copilot-instructions.md
.github/instructions/
.github/prompts/

# manage_demo example writes its migrations here at runtime
/manage_demo_migrations/
# tenancy_manage example writes packaged bootstrap migrations here on first run
/tenancy_manage_migrations/
# local env file with DATABASE_URL etc — never commit
.env
# playwright-mcp debug output (screenshots, page snapshots, console logs)
.playwright-mcp/

# SQLite app demo runtime artifacts
/var/


# Persisted session secrets (#69) — dev fallback when RUSTANGO_SESSION_SECRET unset
.rustango_*_session.key
